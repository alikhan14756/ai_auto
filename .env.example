# ==============================================================================
# CREATOR STUDIO AI — EXHAUSTIVE ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Project Owner: Muhammad Ali (https://alibuild.site)
# Security Notice: NEVER commit real credentials, tokens, or encryption keys.
# Copy this template to .env for local/staging deployments and supply valid values.
#
# Variable Specification Legend:
#   [REQ] Required for core service bootstrap
#   [OPT] Optional / Falls back to local mock or deterministic default
#   [SEC] Secret / Sensitive credential (never log or expose to client)
#   [PUB] Public / Non-sensitive parameter
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION CORE SETTINGS
# ------------------------------------------------------------------------------
# Name: APP_ENV | Purpose: Execution runtime environment | [REQ][PUB]
# Consumed by: FastAPI backend, Next.js frontend | Safe Default: staging
APP_ENV=staging

# Name: APP_NAME | Purpose: Human-readable platform name | [OPT][PUB]
# Consumed by: All services | Safe Default: "Creator Studio AI"
APP_NAME="Creator Studio AI"

# Name: APP_DEBUG | Purpose: Verbose traceback logging (false in staging/prod) | [REQ][PUB]
# Consumed by: FastAPI backend | Safe Default: false
APP_DEBUG=false

# Name: APP_HOST | Purpose: API binding network interface | [REQ][PUB]
# Consumed by: Uvicorn / FastAPI | Safe Default: 0.0.0.0
APP_HOST=0.0.0.0

# Name: APP_PORT | Purpose: API listening port | [REQ][PUB]
# Consumed by: Uvicorn / FastAPI | Safe Default: 8000
APP_PORT=8000

# Name: FRONTEND_URL | Purpose: Canonical URL of Next.js frontend for CORS & redirects | [REQ][PUB]
# Consumed by: FastAPI CORS middleware, OAuth redirect validation | Example: http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Name: NEXT_PUBLIC_API_URL / NEXT_PUBLIC_API_BASE_URL | Purpose: Backend API endpoint exposed to frontend browser | [REQ][PUB]
# Consumed by: Next.js frontend client fetch | Example: http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Name: NEXT_PUBLIC_BASE_PATH | Purpose: Base URL subpath for GitHub Pages project sites | [OPT][PUB]
# Consumed by: Next.js frontend router | Example: /creator-studio-ai (leave blank for user site)
NEXT_PUBLIC_BASE_PATH=

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (POSTGRESQL 16)
# ------------------------------------------------------------------------------
# PostgreSQL Container Credentials (used by docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-secure-postgres-password
POSTGRES_DB=creator_studio_ai

# Name: DATABASE_URL | Purpose: Async connection string for SQLAlchemy engine | [REQ][SEC]
# Consumed by: Backend API, Worker Daemon | Example: postgresql+asyncpg://user:pass@host:5432/dbname
DATABASE_URL=postgresql+asyncpg://postgres:replace-with-secure-postgres-password@localhost:5432/creator_studio_ai

# Name: DATABASE_URL_SYNC | Purpose: Synchronous connection string for Alembic migrations | [REQ][SEC]
# Consumed by: Alembic migration CLI | Example: postgresql://user:pass@host:5432/dbname
DATABASE_URL_SYNC=postgresql://postgres:replace-with-secure-postgres-password@localhost:5432/creator_studio_ai

# Name: DB_POOL_SIZE | Purpose: SQLAlchemy connection pool baseline size | [OPT][PUB]
# Consumed by: app.db.session | Safe Default: 10
DB_POOL_SIZE=10

# Name: DB_MAX_OVERFLOW | Purpose: Maximum overflow connections above pool size | [OPT][PUB]
# Consumed by: app.db.session | Safe Default: 5
DB_MAX_OVERFLOW=5

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & ACCESS CONTROL (SUPABASE / JWT)
# ------------------------------------------------------------------------------
# Name: SUPABASE_URL | Purpose: Supabase project API endpoint | [REQ][PUB]
# Consumed by: Backend auth validation, Frontend Supabase SDK | Example: https://xyz.supabase.co
SUPABASE_URL=https://your-project.supabase.co

# Name: SUPABASE_ANON_KEY | Purpose: Public anonymous client key | [REQ][PUB]
# Consumed by: Frontend client login | Example: eyJhbGciOi...
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Name: NEXT_PUBLIC_SUPABASE_URL | Purpose: Frontend exposed Supabase URL | [REQ][PUB]
# Consumed by: Next.js browser client | Example: https://xyz.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Name: NEXT_PUBLIC_SUPABASE_ANON_KEY | Purpose: Frontend exposed Supabase Anon Key | [REQ][PUB]
# Consumed by: Next.js browser client | Example: eyJhbGciOi...
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Name: SUPABASE_SERVICE_ROLE_KEY | Purpose: Admin service role key for user provisioning | [OPT][SEC]
# Consumed by: Backend auth admin tasks | Example: eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Name: SUPABASE_JWT_SECRET | Purpose: Secret key for verifying Supabase HS256 JWT tokens | [REQ][SEC]
# Consumed by: Backend JWT bearer token dependency | Example: your-supabase-jwt-secret-here
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# ------------------------------------------------------------------------------
# 4. SECURITY & CRYPTOGRAPHY
# ------------------------------------------------------------------------------
# Name: APP_MASTER_ENCRYPTION_KEY | Purpose: 64-char hex key (32 bytes) for AES-256-GCM token encryption | [REQ][SEC]
# Consumed by: app.core.security (OAuth token encryption) | Generate: python -c "import secrets; print(secrets.token_hex(32))"
APP_MASTER_ENCRYPTION_KEY=replace-with-64-character-hex-aes-256-gcm-master-key-here

# Name: APP_SECRET_KEY | Purpose: HMAC signature secret for CSRF state nonces | [REQ][SEC]
# Consumed by: app.core.security, OAuth state verification | Example: a-cryptographically-secure-random-string
APP_SECRET_KEY=replace-with-cryptographically-secure-random-secret-key-here

# ------------------------------------------------------------------------------
# 5. AI PROVIDER CONFIGURATION (GOOGLE GEMINI)
# ------------------------------------------------------------------------------
# Name: GEMINI_API_KEY | Purpose: Google AI Studio API key | [OPT][SEC]
# Consumed by: app.providers.ai.gemini (Falls back to MockAIProvider if unset)
GEMINI_API_KEY=

# Name: GEMINI_MODEL_FAST | Purpose: High-throughput model ID for ideation, drafting & tagging | [OPT][PUB]
# Consumed by: Topic research, Script generation, SEO | Safe Default: gemini-1.5-flash
GEMINI_MODEL_FAST=gemini-1.5-flash

# Name: GEMINI_MODEL_REASONING | Purpose: Deep reasoning model ID for fact-checking & QA | [OPT][PUB]
# Consumed by: Fact-checking, QA validator | Safe Default: gemini-1.5-pro
GEMINI_MODEL_REASONING=gemini-1.5-pro

# Name: FREE_TIER_RPM_LIMIT | Purpose: Maximum sliding-window requests per minute on free key | [OPT][PUB]
# Consumed by: GeminiRateLimiter | Safe Default: 15
FREE_TIER_RPM_LIMIT=15

# Name: FREE_TIER_RPD_LIMIT | Purpose: Maximum requests per calendar day on free key | [OPT][PUB]
# Consumed by: GeminiRateLimiter | Safe Default: 1500
FREE_TIER_RPD_LIMIT=1500

# ------------------------------------------------------------------------------
# 6. SPENDING BUDGET GOVERNOR (FINANCIAL GUARDRAILS)
# ------------------------------------------------------------------------------
# Name: MAX_MONTHLY_SPEND_USD | Purpose: Hard monthly spending ceiling ($0.00 blocks paid APIs) | [REQ][PUB]
# Consumed by: SpendGovernorService, all billable providers | Safe Default: 0.00
MAX_MONTHLY_SPEND_USD=0.00

# Name: MAX_DAILY_SPEND_USD | Purpose: Daily spending cap to prevent burst billing | [OPT][PUB]
# Consumed by: SpendGovernorService | Safe Default: 0.00
MAX_DAILY_SPEND_USD=0.00

# ------------------------------------------------------------------------------
# 7. VOICE & TEXT-TO-SPEECH (TTS) ENGINE
# ------------------------------------------------------------------------------
# Name: TTS_ENGINE | Purpose: Text-to-speech engine choice (edge-tts, mock) | [REQ][PUB]
# Consumed by: app.providers.voice | Safe Default: edge-tts
TTS_ENGINE=edge-tts

# Name: TTS_DEFAULT_VOICE | Purpose: Default neural voice persona identifier | [OPT][PUB]
# Consumed by: Voice studio | Safe Default: en-US-ChristopherNeural
TTS_DEFAULT_VOICE=en-US-ChristopherNeural

# Name: TTS_SPEAKING_RATE | Purpose: Speech rate modifier percentage | [OPT][PUB]
# Consumed by: Audio synthesizer | Safe Default: +5%
TTS_SPEAKING_RATE=+5%

# Name: ELEVENLABS_API_KEY | Purpose: Optional ElevenLabs commercial TTS key | [OPT][SEC]
# Consumed by: ElevenLabs provider (disabled by default under $0.00 spend cap)
ELEVENLABS_API_KEY=

# ------------------------------------------------------------------------------
# 8. STOCK MEDIA PROVIDERS (PEXELS & PIXABAY)
# ------------------------------------------------------------------------------
# Name: PEXELS_API_KEY | Purpose: Pexels REST API key for commercial stock B-roll | [OPT][SEC]
# Consumed by: app.providers.visual.stock_pexels (200 req/hr, 20,000 req/mo)
PEXELS_API_KEY=

# Name: PIXABAY_API_KEY | Purpose: Pixabay REST API key for stock photos & vectors | [OPT][SEC]
# Consumed by: app.providers.visual.stock_pixabay (100 req/min burst, 5,000 req/hr)
PIXABAY_API_KEY=

# ------------------------------------------------------------------------------
# 8B. WEB SEARCH & RESEARCH PROVIDERS
# ------------------------------------------------------------------------------
# Name: SEARCH_PROVIDER | Purpose: Web search provider (duckduckgo, tavily) | [REQ][PUB]
# Consumed by: app.services.research | Safe Default: duckduckgo
SEARCH_PROVIDER=duckduckgo

# Name: TAVILY_API_KEY | Purpose: Optional Tavily AI search key for deep web evidence | [OPT][SEC]
# Consumed by: app.services.research
TAVILY_API_KEY=

# ------------------------------------------------------------------------------
# 9. IMAGE GENERATION & THUMBNAILS
# ------------------------------------------------------------------------------
# Name: THUMBNAIL_OUTPUT_DIR | Purpose: Local storage directory for generated thumbnails | [REQ][PUB]
# Consumed by: Thumbnail Studio (Pillow) | Safe Default: ./storage/thumbnails
THUMBNAIL_OUTPUT_DIR=./storage/thumbnails

# Name: THUMBNAIL_DEFAULT_WIDTH | Purpose: Standard YouTube thumbnail pixel width | [OPT][PUB]
# Consumed by: Thumbnail generator | Safe Default: 1280
THUMBNAIL_DEFAULT_WIDTH=1280

# Name: THUMBNAIL_DEFAULT_HEIGHT | Purpose: Standard YouTube thumbnail pixel height | [OPT][PUB]
# Consumed by: Thumbnail generator | Safe Default: 720
THUMBNAIL_DEFAULT_HEIGHT=720

# Name: THUMBNAIL_MAX_FILE_SIZE_BYTES | Purpose: Hard maximum thumbnail file size (YouTube limit 2MB) | [OPT][PUB]
# Consumed by: Thumbnail QA validator | Safe Default: 2097152
THUMBNAIL_MAX_FILE_SIZE_BYTES=2097152

# ------------------------------------------------------------------------------
# 10. VIDEO PRODUCTION & EDITING (FFMPEG)
# ------------------------------------------------------------------------------
# Name: FFMPEG_PATH | Purpose: Absolute path to ffmpeg executable (auto-detected if unset) | [OPT][PUB]
# Consumed by: app.services.video.renderer | Example: /usr/bin/ffmpeg or C:\ffmpeg\bin\ffmpeg.exe
FFMPEG_PATH=

# Name: FFPROBE_PATH | Purpose: Absolute path to ffprobe executable | [OPT][PUB]
# Consumed by: Audio/Video metadata inspector | Example: /usr/bin/ffprobe
FFPROBE_PATH=

# Name: VIDEO_RENDERER_DEFAULT_MODE | Purpose: Rendering execution mode (auto, ffmpeg, mock) | [REQ][PUB]
# Consumed by: Video timeline renderer | Safe Default: auto
VIDEO_RENDERER_DEFAULT_MODE=auto

# Name: VIDEO_OUTPUT_DIR | Purpose: Local storage directory for rendered video masters | [REQ][PUB]
# Consumed by: Render worker | Safe Default: ./storage/renders
VIDEO_OUTPUT_DIR=./storage/renders

# Name: SUBTITLES_OUTPUT_DIR | Purpose: Directory for compiled subtitle tracks (.srt, .ass) | [REQ][PUB]
# Consumed by: Subtitle compiler | Safe Default: ./storage/subtitles
SUBTITLES_OUTPUT_DIR=./storage/subtitles

# ------------------------------------------------------------------------------
# 11. YOUTUBE OAUTH 2.0 & RESUMABLE PUBLISHING
# ------------------------------------------------------------------------------
# Name: YOUTUBE_CLIENT_ID | Purpose: Google Cloud Console OAuth 2.0 Client ID | [REQ][PUB]
# Consumed by: YouTube OAuth flow | Example: 123456789.apps.googleusercontent.com
YOUTUBE_CLIENT_ID=

# Name: YOUTUBE_CLIENT_SECRET | Purpose: Google Cloud Console OAuth 2.0 Client Secret | [REQ][SEC]
# Consumed by: Backend token exchange endpoint
YOUTUBE_CLIENT_SECRET=

# Name: YOUTUBE_REDIRECT_URI | Purpose: Authorized OAuth redirect URI | [REQ][PUB]
# Consumed by: Google OAuth consent flow | Example: http://localhost:8000/api/v1/youtube/oauth/callback
YOUTUBE_REDIRECT_URI=http://localhost:8000/api/v1/youtube/oauth/callback

# Name: YOUTUBE_USE_MOCK | Purpose: Force mock publishing client (prevents public uploads) | [REQ][PUB]
# Consumed by: YouTube publishing worker | Safe Default: true
YOUTUBE_USE_MOCK=true

# Name: YOUTUBE_UPLOAD_CHUNK_SIZE | Purpose: Resumable chunk buffer size (multiple of 256KB) | [OPT][PUB]
# Consumed by: YouTubeResumableUploader | Safe Default: 8388608 (8MB)
YOUTUBE_UPLOAD_CHUNK_SIZE=8388608

# Name: YOUTUBE_DAILY_UPLOAD_LIMIT | Purpose: Maximum automated video uploads per day | [OPT][PUB]
# Consumed by: Publishing quota sentinel (default free quota max 6) | Safe Default: 4
YOUTUBE_DAILY_UPLOAD_LIMIT=4

# ------------------------------------------------------------------------------
# 12. OBJECT STORAGE (LOCAL / CLOUDFLARE R2)
# ------------------------------------------------------------------------------
# Name: STORAGE_DRIVER | Purpose: Primary media storage driver (local, r2) | [REQ][PUB]
# Consumed by: Storage service | Safe Default: local
STORAGE_DRIVER=local

# Name: LOCAL_STORAGE_DIR | Purpose: Filesystem root for local storage driver | [REQ][PUB]
# Consumed by: Storage service | Safe Default: ./storage
LOCAL_STORAGE_DIR=./storage

# Name: CLOUDFLARE_R2_ACCOUNT_ID | Purpose: Cloudflare account identifier for R2 | [OPT][PUB]
# Consumed by: Cloudflare R2 S3 client
CLOUDFLARE_R2_ACCOUNT_ID=

# Name: CLOUDFLARE_R2_ACCESS_KEY_ID | Purpose: Cloudflare R2 S3 Access Key ID | [OPT][SEC]
# Consumed by: Cloudflare R2 S3 client
CLOUDFLARE_R2_ACCESS_KEY_ID=

# Name: CLOUDFLARE_R2_SECRET_ACCESS_KEY | Purpose: Cloudflare R2 S3 Secret Access Key | [OPT][SEC]
# Consumed by: Cloudflare R2 S3 client
CLOUDFLARE_R2_SECRET_ACCESS_KEY=

# Name: CLOUDFLARE_R2_BUCKET_NAME | Purpose: Target R2 bucket name | [OPT][PUB]
# Consumed by: Cloudflare R2 S3 client | Safe Default: creator-studio-ai
CLOUDFLARE_R2_BUCKET_NAME=creator-studio-ai

# ------------------------------------------------------------------------------
# 13. DURABLE JOB QUEUE & WORKER DAEMON
# ------------------------------------------------------------------------------
# Name: WORKER_ID | Purpose: Unique identifier for worker process instance | [REQ][PUB]
# Consumed by: Worker runner daemon | Safe Default: staging-worker-01
WORKER_ID=staging-worker-01

# Name: WORKER_POLL_INTERVAL | Purpose: Seconds between queue polling cycles | [OPT][PUB]
# Consumed by: Worker runner daemon | Safe Default: 2.0
WORKER_POLL_INTERVAL=2.0

# Name: WORKER_LEASE_SECONDS | Purpose: Duration of atomic job claim before watchdog reclamation | [OPT][PUB]
# Consumed by: JobQueueService, Watchdog | Safe Default: 120
WORKER_LEASE_SECONDS=120

# Name: WORKER_HEARTBEAT_INTERVAL | Purpose: Seconds between worker heartbeat renewals | [OPT][PUB]
# Consumed by: BaseJobHandler | Safe Default: 10.0
WORKER_HEARTBEAT_INTERVAL=10.0

# Name: WORKER_DEFAULT_MAX_RETRIES | Purpose: Maximum retry attempts for transient errors | [OPT][PUB]
# Consumed by: JobQueueService | Safe Default: 3
WORKER_DEFAULT_MAX_RETRIES=3

# Name: WORKER_BASE_BACKOFF_SECONDS | Purpose: Base exponential backoff multiplier (seconds) | [OPT][PUB]
# Consumed by: JobQueueService | Safe Default: 30
WORKER_BASE_BACKOFF_SECONDS=30
