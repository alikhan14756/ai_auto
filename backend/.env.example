# ==============================================================================
# CREATOR STUDIO AI — BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Consumed by: FastAPI Backend Server & Persistent Background Queue Worker
# Security Rule: NEVER commit real production credentials or private tokens.
# ==============================================================================

# Application Core Settings
APP_ENV=development
APP_NAME="Creator Studio AI"
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Application Security & Token Encryption
# Generate 32-byte hex key: python -c "import secrets; print(secrets.token_hex(32))"
APP_MASTER_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
APP_SECRET_KEY=insecure-dev-secret-key-change-in-production

# Relational Database (PostgreSQL 16 / Supabase Free)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/creator_studio_ai
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/creator_studio_ai
DB_POOL_SIZE=4
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT=30

# Supabase Auth Integration
SUPABASE_URL=https://placeholder.supabase.co
SUPABASE_ANON_KEY=placeholder-anon-key
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# AI Provider (Google Gemini) & Hard Spend Cap ($0.00 Default)
GEMINI_API_KEY=
GEMINI_MODEL_FAST=gemini-1.5-flash
GEMINI_MODEL_REASONING=gemini-1.5-pro
MAX_MONTHLY_SPEND_USD=0.00
MAX_DAILY_SPEND_USD=0.00
FREE_TIER_RPM_LIMIT=15
FREE_TIER_RPD_LIMIT=1500

# YouTube Data API & Resumable Publishing
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8000/api/v1/youtube/oauth/callback
YOUTUBE_UPLOAD_ENABLED=true
YOUTUBE_USE_MOCK=true
YOUTUBE_DAILY_UPLOAD_LIMIT=4

# Media & Storage Settings
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage
TTS_ENGINE=edge-tts
TTS_DEFAULT_VOICE=en-US-ChristopherNeural
VIDEO_RENDERER_DEFAULT_MODE=auto

# Background Queue & Worker Daemon
WORKER_POLL_INTERVAL=2.0
WORKER_LEASE_SECONDS=120
WORKER_HEARTBEAT_INTERVAL=10.0
WORKER_DEFAULT_MAX_RETRIES=3
