# ==============================================================================
# CREATOR STUDIO AI — FRONTEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Consumed by: Next.js 15 App Router Frontend
# Security Rule: Only variables prefixed with NEXT_PUBLIC_ are bundled into client JS.
# NEVER place private database passwords, master encryption keys, or OAuth secrets here.
# ==============================================================================

# Backend API Endpoint (HTTP/HTTPS)
# Local development: http://localhost:8000
# Staging with secure tunnel: https://your-tunnel-subdomain.trycloudflare.com
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Public Supabase Client Credentials (Safe for browser exposure)
NEXT_PUBLIC_SUPABASE_URL=https://placeholder.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-anon-key

# GitHub Pages Base Path Prefix (Leave empty for root domain or user site)
# For GitHub Pages project repository (e.g. https://username.github.io/ai_auto):
# Set: NEXT_PUBLIC_BASE_PATH=/ai_auto
NEXT_PUBLIC_BASE_PATH=

# Next.js Build Output Mode (standalone for Docker, export for static GitHub Pages)
OUTPUT_MODE=standalone
